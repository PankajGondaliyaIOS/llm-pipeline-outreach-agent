# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Database
DATABASE_PATH=data/outreach_state.db

# Pipeline Tuning
BATCH_SIZE=10
RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=INFO

# SMTP Configuration
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_FROM_EMAIL=your_email@example.com
SMTP_FROM_NAME=Your Name
SMTP_USER=
SMTP_PASSWORD=

# Sending Rules
DAILY_EMAIL_LIMIT=50
EMAIL_DELAY_MIN_SECONDS=480
EMAIL_DELAY_MAX_SECONDS=720
WORK_HOURS_START=9
WORK_HOURS_END=17